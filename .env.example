# CampusQuest — environment
#
# Copy to `.env.local` and fill in what you need. Every variable is optional:
# with none of them set the app runs, the marketing site and auth flows are
# clickable against a local mock, and the Genius Mining questionnaire works end
# to end against a file-backed store and a stand-in analysis engine.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Absolute origin, used for canonical URLs, social cards, and auth callback
# links. Production must be the live domain — never localhost.
NEXT_PUBLIC_SITE_URL=https://www.joincampusquest.com

# ---------------------------------------------------------------------------
# Supabase — auth and storage
# ---------------------------------------------------------------------------

# Both are needed to enable real auth. Unset, auth falls back to a localStorage
# mock and Genius Mining sessions live in a cookie plus a temp file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required by the retention job and the billing webhook, which act
# on rows with no user session attached. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only HMAC secret for 6-digit URI verification codes. If unset, the
# service-role key is used. Prefer a dedicated secret in production.
EMAIL_VERIFICATION_SECRET=

# Optional comma-separated QA addresses allowed to sign up without @uri.edu.
# QA_SIGNUP_EMAIL=

# ---------------------------------------------------------------------------
# Genius Mining — analysis engine
# ---------------------------------------------------------------------------

# Server-only. Unset, analyses run against a local stand-in and profiles are
# stamped `mock-engine`, which the advisor printout displays as a warning.
ANTHROPIC_API_KEY=

# `mock` or `anthropic`. Defaults to `anthropic` when a key is present and
# `mock` otherwise. Set to `mock` explicitly to avoid spending calls in staging.
GM_ENGINE=

# Phase 1 is URI only.
GM_CAMPUS_ID=uri

# ---------------------------------------------------------------------------
# Email — Resend
# ---------------------------------------------------------------------------

RESEND_API_KEY=

# Verified sender. auth.campusquestapp.com is already verified and sending.
GM_MAIL_FROM=CampusQuest <noreply@auth.campusquestapp.com>

# Where operational alerts go. Comma-separated. Defaults to the gm-alerts group,
# which reaches both Adam and Nick.
GM_ALERT_EMAIL=gm-alerts@campusquestapp.com

# ---------------------------------------------------------------------------
# Jobs and admin
# ---------------------------------------------------------------------------

# Bearer token the retention cron must present. Without it the job refuses to
# run: an unauthenticated endpoint that deletes student data is worse than a job
# that has not been set up yet.
CRON_SECRET=

# Emails allowed into /admin/genius-mining. Required in production; the page
# 404s without it. Comma-separated.
GM_ADMIN_EMAILS=

# Bearer token for applying a subscription change by hand, for support and
# testing. Leave unset in production if you do not need it.
GM_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price ids that grant the Genius Mining tier. Comma-separated. With none set, a
# live subscription is treated as the paid tier, which errs toward keeping data
# rather than deleting it.
STRIPE_PREMIUM_PRICE_IDS=

# Social subscriptions TEST ONLY. No live mode exists in this flow.
# Leave disabled on production. Use a separate test Supabase project, apply
# 0007_test_billing.sql there, and configure $3/$5 USD monthly licensed prices
# in a Stripe sandbox. Existing STRIPE_SECRET_KEY is NEVER used by this flow.
CQ_BILLING_MODE=disabled
CQ_STRIPE_TEST_SECRET_KEY=
CQ_STRIPE_TEST_BASIC_PRICE_ID=
CQ_STRIPE_TEST_PLUS_PRICE_ID=
CQ_STRIPE_TEST_CLUB_PRICE_ID=
CQ_STRIPE_TEST_WEBHOOK_SECRET=
CQ_BILLING_TEST_ORIGIN=http://localhost:43917
# Test endpoint: /api/billing/test-webhook
# Access reads authoritative Stripe status rather than trusting redirect URLs
# or event order. /billing/demo is available in local development only.

# Club workspace TEST ONLY. Apply 0008_clubs_test.sql to the separate test
# database. Reuses verified organization signup; one club per adult owner.
# Club tools have no live mode or email transport in this build.
CQ_CLUB_MODE=disabled
# Verified auth UUIDs, comma-separated. Never use user-editable role metadata.
CQ_CLUB_REVIEWER_IDS=
# /clubs/manage, /clubs/[slug], /clubs/review. /clubs/demo is local-dev only.
# Notifications are saved/previewed and can simulate success/failure; no
# RESEND_API_KEY is read by the club module. Existing email flows are unchanged.

# ---------------------------------------------------------------------------
# Institutional partnerships
# ---------------------------------------------------------------------------

# Where an administrator reading /institutions is told to write. The mailbox
# does not exist yet; until it does the page shows a placeholder on a domain we
# control.
CQ_PARTNERSHIP_EMAIL=

# ---------------------------------------------------------------------------
# Legal
# ---------------------------------------------------------------------------

# The entity that operates CampusQuest and answers for the data. A privacy
# policy has to name a controller and a postal address; "CampusQuest" is a
# product, not a legal person. Until both are set, /privacy and /terms render a
# visible provisional banner rather than quietly omitting the controller.
CQ_LEGAL_ENTITY=
CQ_LEGAL_ADDRESS=

# Where access and deletion requests go. Falls back to CQ_PARTNERSHIP_EMAIL.
CQ_PRIVACY_EMAIL=

# ---------------------------------------------------------------------------
# Activity directory
# ---------------------------------------------------------------------------

# Where the directory is cached when Supabase is not configured. Defaults to a
# JSON file under the system temp directory, so the directory is browsable
# locally after one sync with no database at all.
CQ_LOCAL_ACTIVITIES_PATH=

# ---------------------------------------------------------------------------
# Social
# ---------------------------------------------------------------------------

# Full profile URLs. An unset handle renders no icon; the footer used to show
# icons linking to "#", which reads as an abandoned site.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TWITTER=
NEXT_PUBLIC_SOCIAL_LINKEDIN=

# Set to "true" only once counsel has actually reviewed /privacy and /terms.
# Until then both pages carry a visible provisional banner. Existing is not the
# same as reviewed.
CQ_LEGAL_REVIEWED=

# Where student directory corrections are cached without Supabase.
CQ_LOCAL_REPORTS_PATH=

# Where the age gate caches birth years and guardian consent without Supabase.
CQ_LOCAL_AGE_PATH=

# ---------------------------------------------------------------------------
# The book
# ---------------------------------------------------------------------------
# Override the Amazon listing for The Business of Life: Student Edition. Unset
# is normal — the canonical https://www.amazon.com/dp/B0H3STH3XP is built in.
# Set this only to point somewhere else, such as a direct-sale page later on.
NEXT_PUBLIC_BOOK_URL=

# Set to "false" for an institutional deployment to remove every purchase link
# and QR code. Provenance stays: where the method came from is not marketing,
# and a university evaluating the instrument needs to be able to see it.
CQ_BOOK_COMMERCE=

# Refuse to run an analysis in production with no ANTHROPIC_API_KEY, rather than
# returning a profile generated by a fixture. Set to "true" only on a staging
# deploy where everyone understands the profiles are fake.
GM_ALLOW_MOCK_IN_PRODUCTION=
